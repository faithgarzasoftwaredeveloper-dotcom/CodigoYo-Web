# Public site URL used for canonical links, sitemap, and Open Graph.
# Set this to the production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SkillSprint is a separate application. Leave blank until the real URL is ready.
# Start Learning and Explore SkillSprint use this value.
NEXT_PUBLIC_SKILLSPRINT_URL=

# Optional sign-in URL. If empty, Sign In uses the SkillSprint URL when that is set,
# otherwise it stays on this site at the final call to action.
NEXT_PUBLIC_SIGN_IN_URL=

# Future product URLs. Leave blank while those products are in development.
NEXT_PUBLIC_CAREERS_URL=
NEXT_PUBLIC_STUDIO_URL=
